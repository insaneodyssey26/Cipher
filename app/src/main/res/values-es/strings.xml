    <string name="privacy_policy_tagline">Control de gastos privado. Sin cuentas. Sin nube. Sin rastreo.</string>
    <string name="privacy_short_version_title">Versión corta</string>
    <string name="privacy_short_version_body">Cipher no recopila, transmite ni comparte ninguno de tus datos. Todo permanece en tu dispositivo cifrado.</string>
    <string name="privacy_data_storage_title">Almacenamiento de datos</string>
    <string name="privacy_data_storage_body">Todos los registros de transacciones y ajustes se almacenan localmente en tu dispositivo mediante SQLCipher — una base de datos cifrada.</string>
    <string name="privacy_permissions_title">Permisos de SMS y Apps</string>
    <string name="privacy_permissions_body">Cipher solicita permiso para leer SMS y notificaciones únicamente para detectar y procesar transacciones financieras. El contenido se procesa en memoria y se descarta de inmediato.</string>
    <string name="privacy_biometrics_title">Biometría</string>
    <string name="privacy_biometrics_body">Si habilitas el bloqueo biométrico, la autenticación la gestiona el sistema operativo de tu dispositivo. Cipher nunca almacena ni procesa tus datos biométricos.</string>
    <string name="privacy_network_title">Acceso a la red</string>
    <string name="privacy_network_body">Cipher no solicita permisos de internet y no realiza conexiones de red. No hay servidores remotos, análisis ni publicidad.</string>
    <string name="privacy_exports_title">Exportaciones y copias automáticas</string>
    <string name="privacy_exports_body">Al exportar a CSV, PDF o configurar copia automática, los archivos se guardan directamente en el almacenamiento que elijas. Las copias están cifradas con tu contraseña.</string>
    <string name="privacy_open_source_title">Código abierto</string>
    <string name="privacy_open_source_body">Cipher es de código abierto. Puedes auditar cada línea de código en GitHub para verificar lo anterior.</string>
    <string name="privacy_changes_title">Cambios</string>
